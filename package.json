{
  "name": "staffet",
  "version": "0.1.1",
  "description": "Staffet — an LLM firewall proxy. OpenAI- and Anthropic-compatible endpoints that redact confidential data, guard tool calls, scan generated code and protect classified documents.",
  "keywords": [
    "llm",
    "firewall",
    "proxy",
    "openai",
    "anthropic",
    "claude",
    "security",
    "redaction",
    "dlp"
  ],
  "type": "module",
  "license": "UNLICENSED",
  "homepage": "https://github.com/bahaabdelwahed/staffet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahaabdelwahed/staffet.git"
  },
  "bugs": {
    "url": "https://github.com/bahaabdelwahed/staffet/issues"
  },
  "bin": {
    "staffet": "bin/staffet.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "rules/default/",
    "rules/semgrep/",
    "dashboard/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "node bin/staffet.mjs start",
    "demo": "node bin/staffet.mjs demo",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "staffet": "^0.1.0",
    "undici": "^7.16.0",
    "unpdf": "^1.4.0",
    "yaml": "^2.8.1"
  }
}
